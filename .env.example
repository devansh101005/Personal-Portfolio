# Absolute base URL — every canonical/OG/sitemap URL flows through this (§10, §11).
# Swap this one value to move from *.vercel.app to a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: direct-download Google Drive resume link (the /public/resume.pdf option is strictly better — §8).
RESUME_DRIVE_URL=

# Hashnode publication URL for the /blog link-out (§7).
NEXT_PUBLIC_HASHNODE_URL=
