// Cloudflare Workers (static assets) config. Serves the static export in /out;
// no Worker code runs. `public/_headers` is honoured.
// Live at https://portfolio.devansh10.workers.dev
{
  "name": "portfolio", // must match the Worker name in the Cloudflare dashboard
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
